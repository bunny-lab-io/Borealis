{
  "services": {
    "borealis-operator": {
      "dockerfile": "Data/Engine/Containers/borealis-operator/Dockerfile",
      "context": ".",
      "inputs": [
        ".dockerignore",
        "Data/Engine/Containers/api-backend/go.mod",
        "Data/Engine/Containers/api-backend/go.sum",
        "Data/Engine/Containers/api-backend/cmd/**",
        "Data/Engine/Containers/api-backend/build-api-backend.sh",
        "Data/Engine/Containers/borealis-operator/**"
      ]
    },
    "api-backend": {
      "dockerfile": "Data/Engine/Containers/api-backend/Dockerfile",
      "context": ".",
      "inputs": [
        ".dockerignore",
        "Data/Engine/Containers/api-backend/data/**/*.py",
        "Data/Engine/Containers/api-backend/data/**/*.txt",
        "Data/Engine/Containers/api-backend/data/**/*.ini",
        "Data/Engine/Containers/api-backend/data/alembic/**",
        "Data/Engine/Containers/api-backend/data/Ansible/**",
        "Data/Engine/Containers/api-backend/data/Official_Assemblies/**",
        "Data/Agent/go.mod",
        "Data/Agent/go.sum",
        "Data/Agent/cmd/**",
        "Data/Agent/internal/**",
        "Data/Agent/dist/**",
        "Data/Agent/Agent.ico",
        "Data/Agent/Agent.syso",
        "Data/Agent/Golang_Agent_Migration.md",
        "Data/Engine/Containers/api-backend/**"
      ]
    },
    "job-scheduler": {
      "dockerfile": "Data/Engine/Containers/job-scheduler/Dockerfile",
      "context": ".",
      "inputs": [
        ".dockerignore",
        "Data/Engine/Containers/api-backend/data/**/*.py",
        "Data/Engine/Containers/api-backend/data/**/*.txt",
        "Data/Engine/Containers/api-backend/data/**/*.ini",
        "Data/Engine/Containers/api-backend/data/alembic/**",
        "Data/Engine/Containers/api-backend/data/Ansible/**",
        "Data/Engine/Containers/api-backend/data/Official_Assemblies/**",
        "Data/Engine/Containers/api-backend/go.mod",
        "Data/Engine/Containers/api-backend/go.sum",
        "Data/Engine/Containers/api-backend/cmd/**",
        "Data/Engine/Containers/api-backend/build-api-backend.sh",
        "Data/Agent/go.mod",
        "Data/Agent/go.sum",
        "Data/Agent/cmd/**",
        "Data/Agent/internal/**",
        "Data/Agent/dist/**",
        "Data/Agent/Agent.ico",
        "Data/Agent/Agent.syso",
        "Data/Agent/Golang_Agent_Migration.md",
        "Data/Engine/Containers/job-scheduler/**"
      ]
    },
    "site-worker": {
      "dockerfile": "Data/Engine/Containers/site-worker/Dockerfile",
      "context": ".",
      "inputs": [
        ".dockerignore",
        "Data/Engine/Containers/api-backend/data/**/*.py",
        "Data/Engine/Containers/api-backend/data/**/*.txt",
        "Data/Engine/Containers/api-backend/data/**/*.ini",
        "Data/Engine/Containers/api-backend/data/alembic/**",
        "Data/Engine/Containers/api-backend/data/Ansible/**",
        "Data/Engine/Containers/api-backend/data/Official_Assemblies/**",
        "Data/Agent/go.mod",
        "Data/Agent/go.sum",
        "Data/Agent/cmd/**",
        "Data/Agent/internal/**",
        "Data/Agent/dist/**",
        "Data/Agent/Agent.ico",
        "Data/Agent/Agent.syso",
        "Data/Agent/Golang_Agent_Migration.md",
        "Data/Engine/Containers/site-worker/**"
      ]
    },
    "webui-frontend": {
      "dockerfile": "Data/Engine/Containers/webui-frontend/Dockerfile",
      "context": "Data/Engine/Containers/webui-frontend",
      "targets": {
        "dev": "dev",
        "prod": "prod"
      },
      "inputs": [
        "Data/Engine/Containers/webui-frontend/.dockerignore",
        "Data/Engine/Containers/webui-frontend/data/web-interface/**",
        "Data/Engine/Containers/webui-frontend/**"
      ]
    },
    "traefik-edge": {
      "dockerfile": "Data/Engine/Containers/traefik-edge/Dockerfile",
      "context": "Data/Engine/Containers/traefik-edge",
      "inputs": [
        "Data/Engine/Containers/compose.yaml",
        "Data/Engine/Containers/compose.env.example",
        "Data/Engine/Containers/traefik-edge/.dockerignore",
        "Data/Engine/Containers/traefik-edge/**"
      ]
    },
    "postgres-db": {
      "dockerfile": "Data/Engine/Containers/postgres-db/Dockerfile",
      "context": "Data/Engine/Containers/postgres-db",
      "inputs": [
        "Data/Engine/Containers/postgres-db/.dockerignore",
        "Data/Engine/Containers/postgres-db/**"
      ]
    },
    "remote-desktop-guacd": {
      "dockerfile": "Data/Engine/Containers/remote-desktop-guacd/Dockerfile",
      "context": "Data/Engine/Containers/remote-desktop-guacd",
      "inputs": [
        "Data/Engine/Containers/remote-desktop-guacd/.dockerignore",
        "Data/Engine/Containers/remote-desktop-guacd/**"
      ]
    },
    "wireguard-tunnel": {
      "dockerfile": "Data/Engine/Containers/wireguard-tunnel/Dockerfile",
      "context": "Data/Engine/Containers/wireguard-tunnel",
      "inputs": [
        "Data/Engine/Containers/wireguard-tunnel/.dockerignore",
        "Data/Engine/Containers/wireguard-tunnel/**"
      ]
    }
  }
}
