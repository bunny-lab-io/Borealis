# Borealis Engine Compose environment.
# Engine.sh renders compose.env for Compose interpolation and runtime.env for service env_file injection.
# This example self-references so `docker compose ... config` works before Engine/Deploy exists.

BOREALIS_PROJECT_ROOT=/opt/Borealis
BOREALIS_COMPOSE_PROJECT_NAME=borealis-engine
BOREALIS_RUNTIME_ENV_FILE=compose.env.example
BOREALIS_WEBUI_ENV_FILE=compose.env.example
BOREALIS_ENGINE_RUNTIME_USER=borealis-engine
BOREALIS_ENGINE_RUNTIME_GROUP=borealis-engine
BOREALIS_ENGINE_RUNTIME_OWNER_UID=64646
BOREALIS_ENGINE_RUNTIME_OWNER_GID=64646
BOREALIS_POSTGRES_RUNTIME_UID=999
BOREALIS_POSTGRES_RUNTIME_GID=64646

BOREALIS_ENGINE_MODE=production
BOREALIS_WEBUI_MODE=prod
BOREALIS_ENGINE_HOST_TIMEZONE=Etc/UTC
TZ=Etc/UTC
BOREALIS_WEBUI_TRAFFIC_OWNER=k3s
BOREALIS_WEBUI_UPSTREAM_HOST=10.43.0.10
BOREALIS_WEBUI_UPSTREAM_PORT=8000
BOREALIS_WEBUI_RUNTIME_SOURCE_DIR=/opt/Borealis/Engine/Services/webui-frontend/data/web-interface
BOREALIS_PUBLIC_HOSTNAME=borealis.example.test
BOREALIS_PUBLIC_EDGE_ENABLED=1
BOREALIS_PUBLIC_BASE_URL=https://borealis.example.test
BOREALIS_PUBLIC_HTTPS_PORT=443
BOREALIS_PUBLIC_HTTP_PORT=80
BOREALIS_PUBLIC_VNC_PATH=/remote-desktop/vnc
BOREALIS_PUBLIC_WIREGUARD_HOST=borealis.example.test
BOREALIS_PUBLIC_WIREGUARD_PORT=30000
BOREALIS_PUBLIC_HOSTNAME_ALIASES=borealis.example.test
BOREALIS_ENGINE_IP_FALLBACK=
BOREALIS_ENGINE_NETWORK_MODE=public
BOREALIS_ENGINE_NETWORK_MODE_LABEL=Public
BOREALIS_ENGINE_DEPLOYMENT_PROFILE=externally-accessible
BOREALIS_ENGINE_DEPLOYMENT_PROFILE_LABEL=Externally Accessible
BOREALIS_OPERATOR_NAMESPACE=borealis
BOREALIS_OPERATOR_SERVICE_NAME=borealis-operator
BOREALIS_OPERATOR_PORT=8088
BOREALIS_OPERATOR_BASE_URL=
BOREALIS_OPERATOR_SECRET=change-me-operator-secret
BOREALIS_SITE_WORKER_RUNTIME_SECRET_NAME=borealis-site-worker-runtime-env
BOREALIS_POSTGRES_RUNTIME_SECRET_NAME=borealis-postgres-runtime-env
BOREALIS_WIREGUARD_TUNNEL_RUNTIME_SECRET_NAME=borealis-wireguard-tunnel-runtime-env
BOREALIS_K3S_PVC_STORAGE_CLASS=longhorn
BOREALIS_K3S_POSTGRES_ENABLED=1
BOREALIS_K3S_POSTGRES_STORAGE_SIZE=20Gi
BOREALIS_K3S_POSTGRES_ROLLOUT_TIMEOUT=180s
BOREALIS_ACME_EMAIL=
BOREALIS_LETSENCRYPT_SETTINGS_PATH=/opt/Borealis/Engine/Services/traefik-edge/state/Settings.json
BOREALIS_TRAEFIK_ACME_STORAGE_PATH=/opt/Borealis/Engine/Services/traefik-edge/state/acme.json
BOREALIS_TRAEFIK_RUNTIME_ENV_PATH=/opt/Borealis/Engine/Services/traefik-edge/env/runtime.env
BOREALIS_TRAEFIK_STATIC_CONFIG_PATH=/opt/Borealis/Engine/Services/traefik-edge/config/traefik.yml
BOREALIS_TRAEFIK_DYNAMIC_CONFIG_DIR=/opt/Borealis/Engine/Services/traefik-edge/config/dynamic
BOREALIS_TRAEFIK_DYNAMIC_CONFIG_PATH=/opt/Borealis/Engine/Services/traefik-edge/config/dynamic/core.yml
BOREALIS_TRAEFIK_HEALTH_PORT=8082
BOREALIS_TRAEFIK_TRUSTED_PROXY_IPS=
BOREALIS_TRAEFIK_FORWARDED_HEADERS_TRUSTED_IPS=
BOREALIS_TRAEFIK_PROXY_PROTOCOL_TRUSTED_IPS=
BOREALIS_LOCAL_CA_ENABLED=0
BOREALIS_LOCAL_CA_CERT_PATH=
BOREALIS_LOCAL_CA_KEY_PATH=
BOREALIS_LOCAL_TLS_CERT_PATH=
BOREALIS_LOCAL_TLS_KEY_PATH=
BOREALIS_AGENT_ENGINE_CA_PEM_B64=

BOREALIS_DEPLOYMENT_PROFILE=Homelab
BOREALIS_DEPLOYMENT_PROFILE_RANK=0
BOREALIS_DEPLOYMENT_CPU_RANK=0
BOREALIS_DEPLOYMENT_MEMORY_RANK=0
BOREALIS_DEPLOYMENT_HOST_VCPU=1
BOREALIS_DEPLOYMENT_HOST_MEMORY_MIB=1024
BOREALIS_DEPLOYMENT_HOST_MEMORY_GIB=1.0

BOREALIS_API_BACKEND_MEMORY_LIMIT=512m
BOREALIS_API_BACKEND_CPU_LIMIT=1.50
BOREALIS_API_BACKEND_PIDS_LIMIT=160
BOREALIS_API_BACKEND_K3S_BRIDGE_PORT=5001
BOREALIS_API_BACKEND_TRAFFIC_OWNER=k3s
BOREALIS_API_BACKEND_RUNTIME_OWNER=k3s
BOREALIS_API_BACKEND_UPSTREAM_HOST=127.0.0.1
BOREALIS_API_BACKEND_UPSTREAM_PORT=5001
BOREALIS_JOB_SCHEDULER_MEMORY_LIMIT=256m
BOREALIS_JOB_SCHEDULER_CPU_LIMIT=1.00
BOREALIS_JOB_SCHEDULER_PIDS_LIMIT=160
BOREALIS_JOB_SCHEDULER_RUNTIME_OWNER=k3s
BOREALIS_SITE_WORKER_MEMORY_LIMIT=256m
BOREALIS_SITE_WORKER_CPU_LIMIT=1.00
BOREALIS_SITE_WORKER_PIDS_LIMIT=128
BOREALIS_WEBUI_FRONTEND_MEMORY_LIMIT=256m
BOREALIS_WEBUI_FRONTEND_CPU_LIMIT=0.50
BOREALIS_WEBUI_FRONTEND_PIDS_LIMIT=128
BOREALIS_TRAEFIK_EDGE_MEMORY_LIMIT=256m
BOREALIS_TRAEFIK_EDGE_CPU_LIMIT=1.00
BOREALIS_TRAEFIK_EDGE_PIDS_LIMIT=128
BOREALIS_TRAEFIK_EDGE_RUNTIME_OWNER=k3s
BOREALIS_POSTGRES_DB_MEMORY_LIMIT=1536m
BOREALIS_POSTGRES_DB_CPU_LIMIT=1.50
BOREALIS_POSTGRES_DB_PIDS_LIMIT=256
BOREALIS_POSTGRES_RUNTIME_OWNER=k3s
BOREALIS_REMOTE_DESKTOP_GUACD_MEMORY_LIMIT=256m
BOREALIS_REMOTE_DESKTOP_GUACD_CPU_LIMIT=1.00
BOREALIS_REMOTE_DESKTOP_GUACD_PIDS_LIMIT=64
BOREALIS_REMOTE_DESKTOP_GUACD_RUNTIME_OWNER=k3s
BOREALIS_WIREGUARD_TUNNEL_MEMORY_LIMIT=128m
BOREALIS_WIREGUARD_TUNNEL_CPU_LIMIT=1.00
BOREALIS_WIREGUARD_TUNNEL_PIDS_LIMIT=64
BOREALIS_WIREGUARD_TUNNEL_RUNTIME_OWNER=k3s

POSTGRES_DB=borealis
POSTGRES_USER=borealis
POSTGRES_PASSWORD=change-me
BOREALIS_DATABASE_URL=postgresql://borealis:change-me@127.0.0.1:5432/borealis
BOREALIS_DB_SSLMODE=disable
BOREALIS_DB_POOL_SIZE=10
BOREALIS_DB_MAX_OVERFLOW=10
BOREALIS_DB_CONNECT_TIMEOUT=15
BOREALIS_DB_IDLE_IN_TXN_TIMEOUT_MS=60000
BOREALIS_POSTGRES_MAX_CONNECTIONS=80
BOREALIS_POSTGRES_SHARED_BUFFERS=1GB
BOREALIS_POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
BOREALIS_POSTGRES_WORK_MEM=4MB
BOREALIS_POSTGRES_MAINTENANCE_WORK_MEM=256MB
BOREALIS_POSTGRES_MAX_WORKER_PROCESSES=8
BOREALIS_POSTGRES_MAX_PARALLEL_WORKERS=8
BOREALIS_POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=2
BOREALIS_POSTGRES_AUTOVACUUM_MAX_WORKERS=3
BOREALIS_POSTGRES_AUTOVACUUM_VACUUM_COST_LIMIT=1000
BOREALIS_POSTGRES_AUTOVACUUM_NAPTIME=30s
BOREALIS_POSTGRES_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.02
BOREALIS_POSTGRES_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.01
BOREALIS_POSTGRES_MAX_WAL_SIZE=4GB
BOREALIS_POSTGRES_MIN_WAL_SIZE=512MB
BOREALIS_POSTGRES_EFFECTIVE_IO_CONCURRENCY=16
BOREALIS_POSTGRES_WAL_COMPRESSION=on
BOREALIS_POSTGRES_CHECKPOINT_TIMEOUT=15min
BOREALIS_POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
BOREALIS_POSTGRES_RANDOM_PAGE_COST=1.1

BOREALIS_WEBUI_EXTERNAL=1
BOREALIS_ENGINE_CONTAINERIZED=1
BOREALIS_SCHEDULED_JOBS_START_LOOP=0
BOREALIS_INTERNAL_API_BASE_URL=http://127.0.0.1:5001
BOREALIS_COOKIE_SECURE=1
BOREALIS_GUACAMOLE_ENABLED=1
BOREALIS_GUACD_HOST=127.0.0.1
BOREALIS_GUACD_PORT=4822
BOREALIS_GUACAMOLE_VNC_WS_PATH=/remote-desktop/vnc/guacamole
BOREALIS_VNC_AUTH_PROBE=0
BOREALIS_VNC_WS_HOST=127.0.0.1
BOREALIS_VNC_WS_PORT=4823
BOREALIS_WIREGUARD_PORT=30000
BOREALIS_WIREGUARD_ENGINE_VIRTUAL_IP=10.255.0.1/32
BOREALIS_WIREGUARD_PEER_NETWORK=10.255.0.0/16
BOREALIS_WIREGUARD_PORT_ALLOWLIST=47002,5900,22
BOREALIS_WIREGUARD_CONFIG_ROOT=/opt/Borealis/Engine/Services/wireguard-tunnel/config
BOREALIS_WIREGUARD_KEY_ROOT=/opt/Borealis/Engine/Services/wireguard-tunnel/secrets
BOREALIS_WIREGUARD_CONTROL_SOCKET=/opt/Borealis/Engine/Services/wireguard-tunnel/run/control.sock
BOREALIS_SITE_WORKER_ORCHESTRATOR_SOCKET=/opt/Borealis/Engine/Services/site-worker-orchestrator/run/orchestrator.sock
BOREALIS_SITE_WORKER_LIFECYCLE_MODE=auto
BOREALIS_ALLOW_LEGACY_DOCKER_SITE_WORKERS=0
BOREALIS_ENGINE_SECRET_PATH=/opt/Borealis/Engine/Services/api-backend/secrets/engine_secret.txt
BOREALIS_ENGINE_CERT_ROOT=/opt/Borealis/Engine/Services/api-backend/secrets/Certificates
BOREALIS_ENGINE_AUTH_TOKEN_ROOT=/opt/Borealis/Engine/Services/api-backend/secrets/Auth_Tokens
BOREALIS_ANSIBLE_RUNTIME_ROOT=/opt/Borealis/Engine/Services/api-backend/cache/Ansible
BOREALIS_ANSIBLE_RUNNER_SETTINGS_PATH=/opt/Borealis/Engine/Services/api-backend/config/ansible_runner_settings.json
BOREALIS_SITE_WORKER_SETTINGS_PATH=/opt/Borealis/Engine/Services/api-backend/config/site_worker_settings.json
BOREALIS_SITE_WORKER_SCHEDULED_CONCURRENCY=5
BOREALIS_OFFICIAL_ASSEMBLIES_CHECKOUT_ROOT=/opt/Borealis/Engine/Services/api-backend/cache
BOREALIS_LOG_FILE=/opt/Borealis/Engine/Services/api-backend/logs/engine.log
BOREALIS_ERROR_LOG_FILE=/opt/Borealis/Engine/Services/api-backend/logs/error.log
BOREALIS_API_LOG_FILE=/opt/Borealis/Engine/Services/api-backend/logs/api.log
BOREALIS_VPN_TUNNEL_LOG_FILE=/opt/Borealis/Engine/Services/api-backend/logs/VPN_Tunnel/tunnel.log
BOREALIS_WIREGUARD_LOG_FILE=/opt/Borealis/Engine/Services/api-backend/logs/VPN_Tunnel/tunnel.log

BOREALIS_OPERATOR_IMAGE=borealis-engine/borealis-operator:local
BOREALIS_API_BACKEND_IMAGE=borealis-engine/api-backend:local
BOREALIS_JOB_SCHEDULER_IMAGE=borealis-engine/job-scheduler:local
BOREALIS_SITE_WORKER_IMAGE=borealis-engine/site-worker:local
BOREALIS_WEBUI_FRONTEND_IMAGE=borealis-engine/webui-frontend:local
BOREALIS_TRAEFIK_EDGE_IMAGE=borealis-engine/traefik-edge:local
BOREALIS_POSTGRES_DB_IMAGE=borealis-engine/postgres-db:local
BOREALIS_REMOTE_DESKTOP_GUACD_IMAGE=borealis-engine/remote-desktop-guacd:local
BOREALIS_WIREGUARD_TUNNEL_IMAGE=borealis-engine/wireguard-tunnel:local
