[Unit]
Description=Borealis Engine Node Manager
After=network-online.target k3s.service
Wants=network-online.target
Requires=k3s.service

[Service]
Type=simple
User=root
Group=root
Environment=BOREALIS_PROJECT_ROOT=/opt/Borealis
ExecStart=/usr/local/sbin/borealis-node-manager serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/Borealis /run/borealis /etc/borealis
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
