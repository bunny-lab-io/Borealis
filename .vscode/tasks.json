{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Borealis - Server (Production)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/Borealis.ps1",
        "-Server", "-Flask"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
